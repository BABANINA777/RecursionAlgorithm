<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RecursionAlgorithm.View.Views.PythagorasTreeView"
             xmlns:vm="clr-namespace:RecursionAlgorithm.ViewModels"
             xmlns:views="clr-namespace:RecursionAlgorithm.View.Views"
             xmlns:pythagorasTree="clr-namespace:RecursionAlgorithm.View.Views.PythagorasTree"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto, *, Auto">
        <!--кнопки управления-->
        <Grid Grid.Row="0" Margin="20">
            <!-- Кнопка возврата-->
            <Button Height="44" Width="44" 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding GoBackCommand}" 
                    Background="#1E1E24" 
                    BorderThickness="1" 
                    BorderBrush="#33FFFFFF" 
                    CornerRadius="8" 
                    Padding="0">
                <Path Data="M 5, 25 L 20 10 L 20 20 L 40 20 L 40 30 L 20 30 L 20 40 L 5 25"  
                      StrokeThickness="1" 
                      Stroke="White" 
                      Fill="White" 
                      Width="16" Height="16" 
                      Stretch="Uniform" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>

            <!-- Заголовок-->
            <TextBlock Text="Древо Пифагора"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="26"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI, Inter, Cantarell, Ubuntu, sans-serif"
                       LetterSpacing="0.5">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#C68642" Offset="0.0"/>
                        <GradientStop Color="#A28834" Offset="0.45"/>
                        <GradientStop Color="#4EBA6F" Offset="1.0"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
        </Grid>
        
        <!--Алгоритм-->
        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            <views:PythagorasTreeControl x:Name="TreeControl" Grid.Column="0" />
            <pythagorasTree:RecursionTreePT x:Name="RecursionControl" Grid.Column="1" />
        </Grid>
        
        
        <!--НИЖНЯЯ ПАНЕЛЬ УПРАВЛЕНИЯ-->
        <Border Grid.Row="2" 
        Margin="20,0,20,20" 
        Padding="20,14" 
        Background="#1E1E24" 
        BorderBrush="#33FFFFFF" 
        BorderThickness="1" 
        CornerRadius="12">
    <Grid ColumnDefinitions="*, 32, *">
        <!-- Слайдер 1: Глубина рекурсии -->
        <StackPanel Grid.Column="0" Spacing="8">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Глубина рекурсии" Foreground="#A0A0B2" FontSize="13" VerticalAlignment="Center"/>
                <!-- Числовое значение рядом -->
                <Border Grid.Column="1" Background="#282834" CornerRadius="6" Padding="10,2">
                    <TextBlock Text="{Binding #TreeControl.Depth}" 
                               Foreground="#10B981" FontWeight="Bold" FontSize="13"/>
                </Border>
            </Grid>
            <Slider Minimum="1" Maximum="14" 
                    Value="{Binding #TreeControl.Depth}" 
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
        </StackPanel>

        <!-- Слайдер 2: Угол наклона -->
        <StackPanel Grid.Column="2" Spacing="8">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="Угол наклона веток" Foreground="#A0A0B2" FontSize="13" VerticalAlignment="Center"/>
                <!-- Значение в градусах рядом -->
                <Border Grid.Column="1" Background="#282834" CornerRadius="6" Padding="10,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding #TreeControl.Angle, StringFormat='{}{0:F0}'}" 
                                   Foreground="#34D399" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="°" Foreground="#34D399" FontWeight="Bold" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Slider Minimum="10" Maximum="80" 
                    Value="{Binding #TreeControl.Angle}" 
                    TickFrequency="1" IsSnapToTickEnabled="True"/>
        </StackPanel>
    </Grid>
</Border>

    </Grid>
</UserControl>
