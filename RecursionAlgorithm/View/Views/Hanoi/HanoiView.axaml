<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RecursionAlgorithm.ViewModels"
             xmlns:views="clr-namespace:RecursionAlgorithm.View.Views"
             xmlns:common="clr-namespace:RecursionAlgorithm.View.Views.Common"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="RecursionAlgorithm.View.Views.HanoiView"
             x:Name="Root"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Margin="20">
            <Button Height="44" Width="44" HorizontalAlignment="Left"
                    Command="{Binding GoBackCommand}" Background="#1E1E24"
                    BorderThickness="1" BorderBrush="#33FFFFFF" CornerRadius="8" Padding="0">
                <Path Data="M 5,25 L 20,10 L 20,20 L 40,20 L 40,30 L 20,30 L 20,40 Z"
                      Stroke="White" Fill="White" Width="16" Height="16" Stretch="Uniform"/>
            </Button>
            <TextBlock Text="Ханойские башни" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="26" FontWeight="SemiBold" Foreground="#A78BFA"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            <Border Grid.Row="0" Margin="20,0,20,15" Background="#1E1E24" CornerRadius="12"
                    BorderBrush="#33FFFFFF" BorderThickness="1" ClipToBounds="True">
                <Grid RowDefinitions="*,Auto">
                    <views:HanoiControl x:Name="HanoiBoard" DiskCount="5" StateChanged="OnStateChanged"/>
                    <TextBlock Grid.Row="1" Margin="0,0,0,14" HorizontalAlignment="Center"
                               Text="A — начальная башня     B — вспомогательная     C — целевая башня"
                               Foreground="#A0A0B2" FontSize="13"/>
                </Grid>
            </Border>
            <common:RecursionTreeControl x:Name="RecursionControl" Grid.Column="1" />
            
        </Grid>
        

        <Border Grid.Row="2" Margin="20,0,20,20" Padding="16,12" Background="#1E1E24"
                BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Дисков:" Foreground="#A0A0B2" VerticalAlignment="Center"/>
                    <TextBox x:Name="DiskInput" Width="76" Height="36" Text="5"
                             TextChanged="OnDiskCountTextChanged" KeyDown="OnDiskInputKeyDown"
                             Background="#3A3A46" Foreground="White" BorderBrush="#85859A"
                             BorderThickness="1" CornerRadius="8" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="▶  Старт" Click="Play_Click" Margin="0,0,8,0"
                        Background="#7C3AED" Foreground="White" CornerRadius="8" Padding="16,8"/>
                <Button Grid.Column="2" Content="Ⅱ  Пауза" Click="Pause_Click" Margin="0,0,8,0"
                        Background="#282834" Foreground="White" CornerRadius="8" Padding="16,8"/>
                <Button Grid.Column="3" Content="Сначала" Click="Reset_Click"
                        Background="#282834" Foreground="White" CornerRadius="8" Padding="16,8"/>
                <TextBlock Grid.Column="5" x:Name="ProgressText" Text="Ход 0 из 31 · минимум ходов: 31"
                           Foreground="#C4B5FD" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
