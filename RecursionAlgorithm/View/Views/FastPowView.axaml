<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RecursionAlgorithm.View.Views.FastPowView"
             xmlns:vm="clr-namespace:RecursionAlgorithm.ViewModels"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto, *, Auto">
        <!--кнопки управления-->
        <StackPanel Orientation="Horizontal" Spacing="20" Margin="20" VerticalAlignment="Center">
            <Button Height="44" Width="44" 
                    Command="{Binding GoBackCommand}" 
                    Background="#1E1E24" 
                    BorderThickness="1" 
                    BorderBrush="#33FFFFFF" 
                    CornerRadius="8" 
                    Padding="0">
                <Path Data="M 5, 25 L 20 10 L 20 20 L 40 20 L 40 30 L 20 30 L 20 40 L 5 25"  
                      StrokeThickness="1" 
                      Stroke="White" 
                      Fill="White" 
                      Width="16" Height="16" 
                      Stretch="Uniform" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
        
        <!--Алгоритм-->
        
        
        <!--НИЖНЯЯ ПАНЕЛЬ УПРАВЛЕНИЯ-->
        <Border Grid.Row="2" 
                Margin="20,0,20,20" 
                Padding="16,12" 
                Background="#1E1E24" 
                BorderBrush="#33FFFFFF" 
                BorderThickness="1" 
                CornerRadius="12">
        </Border>
    </Grid>
</UserControl>
