<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RecursionAlgorithm.View.Views.KnapsackView"
             x:Name="KnapsackRoot"
             xmlns:vm="clr-namespace:RecursionAlgorithm.ViewModels"
             xmlns:avalonia="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto, *, Auto">
        <!-- ВЕРХНЯЯ ПАНЕЛЬ: Кнопка назад и заголовок -->
        <Grid Grid.Row="0" Margin="20">
            <!-- Кнопка возврата -->
            <Button Height="44" Width="44" 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding GoBackCommand}" 
                    Background="#1E1E24" 
                    BorderThickness="1" 
                    BorderBrush="#33FFFFFF" 
                    CornerRadius="8" 
                    Padding="0">
                <Path Data="M 5, 25 L 20 10 L 20 20 L 40 20 L 40 30 L 20 30 L 20 40 L 5 25"  
                      StrokeThickness="1" 
                      Stroke="White" 
                      Fill="White" 
                      Width="16" Height="16" 
                      Stretch="Uniform" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"/>
            </Button>

            <!-- Градиентный заголовок -->
            <TextBlock Text="Задача о рюкзаке"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="26"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI, Inter, Cantarell, Ubuntu, sans-serif"
                       LetterSpacing="0.5">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#F59E0B" Offset="0.0"/>
                        <GradientStop Color="#D97706" Offset="0.5"/>
                        <GradientStop Color="#B45309" Offset="1.0"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
        </Grid>
        
        <!-- ГРАФИК -->
        <Border Grid.Row="1" Margin="20,0,20,15" Background="#1E1E24" CornerRadius="12" ClipToBounds="True">
            <avalonia:AvaPlot Name="BenchmarkPlot" />
        </Border>
        
        <!-- НИЖНЯЯ ПАНЕЛЬ УПРАВЛЕНИЯ -->
        <Border Grid.Row="2" 
                Margin="20,0,20,20" 
                Padding="16,12" 
                Background="#1E1E24" 
                BorderBrush="#33FFFFFF" 
                BorderThickness="1" 
                CornerRadius="12">
            <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto">
                <!-- Размерность N -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Размерность (N):" Foreground="#A0A0B2" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="NSizeInput" 
                             Width="75" 
                             Height="36" 
                             Text="{Binding #KnapsackRoot.NSize, Mode=TwoWay}"
                             KeyDown="OnInputKeyDown"
                             Background="#121214" 
                             Foreground="White" 
                             BorderBrush="#33FFFFFF" 
                             BorderThickness="1" 
                             CornerRadius="8" 
                             VerticalContentAlignment="Center" 
                             HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Макс. вес W -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Макс. вес (W):" Foreground="#A0A0B2" FontSize="13" VerticalAlignment="Center"/>
                    <TextBox x:Name="MaxWeightInput" 
                             Width="75" 
                             Height="36" 
                             Text="{Binding #KnapsackRoot.MaxWeight, Mode=TwoWay}"
                             KeyDown="OnInputKeyDown"
                             Background="#121214" 
                             Foreground="White" 
                             BorderBrush="#33FFFFFF" 
                             BorderThickness="1" 
                             CornerRadius="8" 
                             VerticalContentAlignment="Center" 
                             HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Кнопка «Прогон» -->
                <Button Grid.Column="2" 
                        x:Name="RunButton"
                        Click="RunButton_Click"
                        Height="36" 
                        Padding="18,0" 
                        Background="#D97706" 
                        Foreground="White" 
                        FontWeight="SemiBold" 
                        CornerRadius="8" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Path Data="M 4 2 L 14 8 L 4 14 Z" Fill="White" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="Прогон" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Результаты расчета (справа) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#282834" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Шагов:" Foreground="#A0A0B2" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StepsResultText" Text="0" Foreground="#F59E0B" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#282834" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Лучшая ценность:" Foreground="#A0A0B2" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BestCostResultText" Text="0" Foreground="#10B981" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
